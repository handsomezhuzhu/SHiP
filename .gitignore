# env / 本地工具链（不入库）
env/

# TA-MPPPB 以 git submodule 形式纳入（见 .gitmodules）

# 模拟器与构建产物
build/
bin/
sim/llc_sim
*.o
*.d
*.a

# Benchmark trace（体积大，用 scripts/get_traces.sh / scripts/get_ext_traces.py 重新下载）
traces/
traces_new/

# 论文 PDF（版权原因不入库，用 scripts/fetch_papers.sh 重新下载）
papers/pdf/

# 运行产生的原始输出（实验数据随仓库入库，仅忽略顶层临时日志）
results/*.log

# 论文（paper/）：LaTeX 源码、配图与最终 main.pdf 入库，
# 仅忽略编译中间产物与期刊模板附带的示例 PDF（体积大且非论文本体）
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/Template.pdf
paper/CJC1.pdf
paper/计算机学报__Debug模板.pdf
